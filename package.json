{
  "name": "connector-platform-root",
  "version": "1.0.0",
  "description": "Unified entry point for Connector Ingestion Platform",
  "private": true,
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "pip install -r backend/requirements.txt",
    "install:all": "npm run install:frontend && npm run install:backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python -m uvicorn main:app --reload --app-dir backend",
    "dev": "concurrently -k \"npm:dev:frontend\" \"npm:dev:backend\"",
    "clean": "rm -rf backend/uploads/*"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
